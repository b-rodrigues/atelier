#!/usr/bin/env bash

# Resolve absolute paths
REPO_DIR="${REPO_DIR:-/home/brodrigues/Documents/repos/tlang}"
ATELIER_DIR="${ATELIER_DIR:-/home/brodrigues/Documents/repos/atelier}"

SESSION_NAME="atelier"

# 1. Clean up old session if any
tmux kill-session -t "$SESSION_NAME" 2>/dev/null

# Clean up temp files
rm -f /tmp/atelier-cmd
rm -f /tmp/atelier-vars.csv

# 2. Parse configuration file ~/.config/ateliers/settings.toml
CONFIG_FILE="$HOME/.config/ateliers/settings.toml"
DEFAULT_EDITOR="nvim"
EDITOR_CHOICE="$DEFAULT_EDITOR"

if [ -f "$CONFIG_FILE" ]; then
  # Simple grep/sed extraction of the "editor" field
  EXTRACTED_EDITOR=$(grep -E '^\s*editor\s*=' "$CONFIG_FILE" | cut -d'=' -f2 | tr -d '"'\'' ')
  if [ "$EXTRACTED_EDITOR" = "nano" ] || [ "$EXTRACTED_EDITOR" = "nvim" ]; then
    EDITOR_CHOICE="$EXTRACTED_EDITOR"
  fi
fi

# Set the editor command line based on choice
if [ "$EDITOR_CHOICE" = "nano" ]; then
  EDITOR_CMD="nix develop $REPO_DIR --command nano"
else
  EDITOR_CMD="nix develop $REPO_DIR --command nvim -u $ATELIER_DIR/atelier-init.lua"
fi

# 3. Create a new tmux session and start the chosen Editor in Pane 0 (top-left)
tmux new-session -d -s "$SESSION_NAME" -n "Atelier" "$EDITOR_CMD"

# 3. Create Pane 1: T REPL (top-right)
# Split horizontally (split window into left and right)
# Run T REPL. Exiting REPL (1st Ctrl-D) drops to shell, exiting shell (2nd Ctrl-D) kills the session.
tmux split-window -h -t "$SESSION_NAME:0.0" \
  "export TLANG_REPO_ROOT=$REPO_DIR; nix develop $REPO_DIR --command bash -c 'dune exec --root $REPO_DIR -- src/repl.exe; bash; tmux kill-session -t $SESSION_NAME'"

# 4. Create Pane 3: Files pane (bottom-right)
# Split Pane 1 vertically
# Show header and enter interactive shell in ATELIER_DIR
tmux split-window -v -t "$SESSION_NAME:0.1" \
  "clear; echo -e '\033[1;34mAtelier Files Pane\033[0m'; echo -e '\033[38;5;242m──────────────────\033[0m'; ls -F --color=always; echo ''; exec \$SHELL"

# 5. Create Pane 2: Variables watcher (bottom-left)
# Split Pane 0 vertically
tmux split-window -v -t "$SESSION_NAME:0.0" \
  "python3 $ATELIER_DIR/atelier-vars.py"

# 6. Customize status bar to display commands at the bottom (like nano)
if [ "$EDITOR_CHOICE" = "nano" ]; then
  STATUS_RIGHT="#[fg=colour249,bg=colour235] [Nano Editor]  │  Ctrl+b + Arrows: Navigate  │  Ctrl-d (2x): Exit  "
else
  STATUS_RIGHT="#[fg=colour249,bg=colour235] Space+e/Ctrl+Enter: Eval  │  Ctrl+b + Arrows: Navigate  │  Ctrl-d (2x): Exit  "
fi

tmux set-option -t "$SESSION_NAME" status-style "bg=colour235,fg=colour245"
tmux set-option -t "$SESSION_NAME" status-left "#[fg=colour117,bg=colour235,bold]  Atelier TUI  "
tmux set-option -t "$SESSION_NAME" status-right "$STATUS_RIGHT"
tmux set-option -t "$SESSION_NAME" status-right-length 120

# 7. Start the watcher in the background
# The watcher checks if the tmux session is still running and cleans up if not
"$ATELIER_DIR/atelier-watcher.sh" &

# 8. Attach to the tmux session
tmux attach-session -t "$SESSION_NAME"
