#!/usr/bin/env bash

# Resolve absolute paths dynamically
ATELIER_DIR="${ATELIER_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
REPO_DIR="${REPO_DIR:-$PWD}"

SESSION_NAME="atelier"

# 1. Clean up old session if any
tmux kill-session -t "$SESSION_NAME" 2>/dev/null

# Clean up temp files
rm -f /tmp/atelier-cmd
rm -f /tmp/atelier-vars.csv

# 2. Parse configuration file ~/.config/atelier/settings.toml (preferred) or ~/.config/ateliers/settings.toml (fallback)
CONFIG_FILE="$HOME/.config/atelier/settings.toml"
OLD_CONFIG_FILE="$HOME/.config/ateliers/settings.toml"

# Detect which editor is available as default
DEFAULT_EDITOR="nvim"
if ! command -v nvim >/dev/null 2>&1; then
  if command -v nano >/dev/null 2>&1; then
    DEFAULT_EDITOR="nano"
  elif command -v vim >/dev/null 2>&1; then
    DEFAULT_EDITOR="vim"
  else
    DEFAULT_EDITOR="vi"
  fi
fi

EDITOR_CHOICE="$DEFAULT_EDITOR"

ACTIVE_CONFIG=""
if [ -f "$CONFIG_FILE" ]; then
  ACTIVE_CONFIG="$CONFIG_FILE"
elif [ -f "$OLD_CONFIG_FILE" ]; then
  ACTIVE_CONFIG="$OLD_CONFIG_FILE"
fi

if [ -n "$ACTIVE_CONFIG" ]; then
  # Simple grep/sed extraction of the "editor" field
  EXTRACTED_EDITOR=$(grep -E '^\s*editor\s*=' "$ACTIVE_CONFIG" | cut -d'=' -f2 | tr -d '"'\'' ')
  if [ "$EXTRACTED_EDITOR" = "nano" ] || [ "$EXTRACTED_EDITOR" = "nvim" ] || [ "$EXTRACTED_EDITOR" = "vim" ] || [ "$EXTRACTED_EDITOR" = "vi" ]; then
    EDITOR_CHOICE="$EXTRACTED_EDITOR"
  fi
fi

# Set the editor command line based on choice
if [ "$EDITOR_CHOICE" = "nano" ]; then
  EDITOR_CMD="nix develop $REPO_DIR --command nano"
elif [ "$EDITOR_CHOICE" = "vim" ] || [ "$EDITOR_CHOICE" = "vi" ]; then
  EDITOR_CMD="nix develop $REPO_DIR --command $EDITOR_CHOICE"
else
  EDITOR_CMD="nix develop $REPO_DIR --command nvim -u $ATELIER_DIR/atelier-init.lua"
fi

# 3. Create a new tmux session and start the chosen Editor in Pane 0 (top-left)
tmux new-session -d -s "$SESSION_NAME" -n "Atelier" "$EDITOR_CMD"

# 3. Create Pane 1: T REPL (top-right)
# Split horizontally (split window into left and right)
# Run T REPL. Exiting REPL (1st Ctrl-D) drops to shell, exiting shell (2nd Ctrl-D) kills the session.
if [ -f "$REPO_DIR/dune-project" ] && [ -d "$REPO_DIR/src" ]; then
  REPL_CMD="dune exec --root $REPO_DIR -- src/repl.exe"
else
  REPL_CMD="t repl"
fi

tmux split-window -h -t "$SESSION_NAME:0.0" \
  "export TLANG_REPO_ROOT=$REPO_DIR; nix develop $REPO_DIR --command bash -c '$REPL_CMD; stty sane; bash; tmux kill-session -t $SESSION_NAME'"

# 4. Create Pane 3: Terminal pane (bottom-right)
# Split Pane 1 vertically
# Show header and enter interactive shell in ATELIER_DIR
tmux split-window -v -t "$SESSION_NAME:0.1" \
  "clear; echo -e '\033[1;34mTerminal\033[0m'; echo -e '\033[38;5;242m──────────────────\033[0m'; ls -F --color=always; echo ''; exec \$SHELL -o vi"

# 5. Create Pane 2: Variables watcher (bottom-left)
# Split Pane 0 vertically
tmux split-window -v -t "$SESSION_NAME:0.0" \
  "nix develop $REPO_DIR --command python3 $ATELIER_DIR/atelier-vars.py"

# 6. Customize status bar to display commands at the bottom (like nano/vim/nvim)
if [ "$EDITOR_CHOICE" = "nano" ] || [ "$EDITOR_CHOICE" = "vim" ] || [ "$EDITOR_CHOICE" = "vi" ]; then
  STATUS_RIGHT="#[fg=colour249,bg=colour235] [$(echo "$EDITOR_CHOICE" | tr 'a-z' 'A-Z') Editor]  │  Alt+h/j/k/l: Nav  │  Ctrl-d (2x): Exit  "
else
  STATUS_RIGHT="#[fg=colour249,bg=colour235] Space+e: Eval │ Space+f: Files │ Space+b: Buffers │ Space+q+q: Exit │ Alt+h/j/k/l: Nav "
fi

tmux set-option -t "$SESSION_NAME" status-style "bg=colour235,fg=colour245"
tmux set-option -t "$SESSION_NAME" status-left "#[fg=colour117,bg=colour235,bold]  Atelier TUI  "
tmux set-option -t "$SESSION_NAME" status-right "$STATUS_RIGHT"
tmux set-option -t "$SESSION_NAME" status-right-length 120

# 6.5. Enable Vi keys and global Alt-h/j/k/l navigation in tmux
tmux set-window-option -t "$SESSION_NAME" mode-keys vi
tmux set-option -t "$SESSION_NAME" status-keys vi

tmux bind-key -n M-h select-pane -L
tmux bind-key -n M-j select-pane -D
tmux bind-key -n M-k select-pane -U
tmux bind-key -n M-l select-pane -R

tmux bind-key -n M-Left select-pane -L
tmux bind-key -n M-Down select-pane -D
tmux bind-key -n M-Up select-pane -U
tmux bind-key -n M-Right select-pane -R

# 7. Start the watcher in the background
# The watcher checks if the tmux session is still running and cleans up if not
"$ATELIER_DIR/atelier-watcher.sh" &

# 8. Attach to the tmux session
tmux attach-session -t "$SESSION_NAME"
